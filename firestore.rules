rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelfByPath(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSelfByPayload() {
      return isSignedIn() &&
        request.resource.data.userId is string &&
        request.resource.data.userId == request.auth.uid;
    }

    function isAdminUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/USERS/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/USERS/$(request.auth.uid)).data.role == 'ADMIN' ||
          get(/databases/$(database)/documents/USERS/$(request.auth.uid)).data.role == 'OFFICE_ADMIN'
        );
    }

    function isOfficerWithAccess(uid) {
      return exists(/databases/$(database)/documents/USERS/$(uid));
    }
    
    // Read departments for login screen
    match /DEPARTMENTS/{docId} {
      allow read: if true;
      allow write: if false; // seeder uses admin SDK
    }
    match /COMPLAINT_TYPES/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    
    // Citizens: create tickets, read own tickets
    match /TICKETS/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.citizenId == request.auth.uid ||
        isOfficerWithAccess(request.auth.uid)
      );
      allow update: if isSignedIn() && isOfficerWithAccess(request.auth.uid);
    }
    
    // Anyone authenticated can create notifications, only owner can read/update
    match /NOTIFICATIONS/{notifId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (
          request.auth.token.email != null &&
          resource.data.recipientEmail is string &&
          resource.data.recipientEmail == request.auth.token.email
        )
      );
    }
    
    // Escalation and status logs — officers can create, not delete
    match /ESCALATION_LOGS/{logId} {
      allow read, create: if isSignedIn();
      allow delete: if false;
    }
    match /TICKET_STATUS_LOGS/{logId} {
      allow read, create: if isSignedIn();
      allow delete: if false;
    }
    
    // Geographic collections
    // OFFICES is public-read so login can load office dropdown before authentication.
    match /OFFICES/{docId} { allow read: if true; }
    match /REGIONS/{docId} { allow read: if isSignedIn(); }
    match /CIRCLES/{docId} { allow read: if isSignedIn(); }
    match /DIVISIONS/{docId} { allow read: if isSignedIn(); }
    match /CLUSTERS/{docId} { 
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    // USERS
    // - public read is needed for pre-auth officer selection on login screen
    // - self create/update is required for JIT profile migration after Firebase Auth sign-in
    // - admin write is required for staff management
    match /USERS/{userId} {
      allow read: if true;
      allow create: if (
        isSelfByPath(userId) ||
        isSelfByPayload() ||
        isAdminUser()
      );
      allow update: if (
        isSelfByPath(userId) ||
        resource.data.userId == request.auth.uid ||
        isSelfByPayload() ||
        isAdminUser()
      );
      allow delete: if isSignedIn() && (
        isSelfByPath(userId) ||
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isAdminUser()
      );
    }
  }
}
